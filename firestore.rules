rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validUserProfile(userId) {
      return request.resource.data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 24
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if signedInAs(userId);
      allow list: if false;
      allow create: if signedInAs(userId) && validUserProfile(userId);
      allow update: if signedInAs(userId)
        && validUserProfile(userId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /rooms/{roomCode} {
      allow get: if request.auth != null && request.auth.uid in resource.data.playerUids;
      allow list, create, update, delete: if false;
    }

    match /matches/{matchId} {
      allow get: if request.auth != null && request.auth.uid in resource.data.playerUids;
      allow list, create, update, delete: if false;
    }

    match /quickMatchTickets/{userId} {
      allow get: if signedInAs(userId);
      allow list, create, update, delete: if false;
    }

    // Match state, dice rolls, rewards, and all unspecified collections are server-owned.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
